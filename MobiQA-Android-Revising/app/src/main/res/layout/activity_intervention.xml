<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Refresh Button Area -->
        <Button
            android:id="@+id/btn_refresh_intervention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Refresh Log and Suggestion"
            android:backgroundTint="@color/primary_color"
            android:textColor="@color/text_light"
            android:textSize="16sp"/>

        <!-- Hourly Log Display Area-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Your Hourly Summary"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/hourly_log_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_intervention"
                android:minHeight="100dp"
                android:padding="16dp"
                android:text="Loading hourly summary..."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!--Log Feedback Form Area-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Feedback"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:spacing="20dp">

                <!--Log Question 1: Log Quality/Accuracy Score (0-5)-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. How would you rate the accuracy of the log? (0 = completely inaccurate, 5 = completely accurate)"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/log_feedback_group_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton android:id="@+id/log_feedback_1_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_1_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_1_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_1_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_1_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_1_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="14sp"/>
                    </RadioGroup>
                </LinearLayout>

                <!--Log Question 2: Content Preference Match (Yes/No)-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Does the log match your content preferences?"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/log_feedback_group_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton android:id="@+id/log_feedback_2_yes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yes" android:textSize="14sp"/>
                        <RadioButton android:id="@+id/log_feedback_2_no" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No" android:textSize="14sp" android:layout_marginStart="24dp"/>
                    </RadioGroup>
                </LinearLayout>

                <!--Log Question 2b: Content Preference Selection (conditional, shown when Q2 is No)-->
                <LinearLayout
                    android:id="@+id/log_feedback_q2b_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    android:paddingStart="16dp"
                    android:background="@drawable/bg_intervention">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please select your preferred content categories:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/log_feedback_pref_study_work"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Learning and Work"
                        android:textSize="14sp"/>

                    <CheckBox
                        android:id="@+id/log_feedback_pref_sports_health"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sports and Health"
                        android:textSize="14sp"/>

                    <CheckBox
                        android:id="@+id/log_feedback_pref_phone_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Usage"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <CheckBox
                            android:id="@+id/log_feedback_pref_other"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Other"
                            android:textSize="14sp"/>

                        <EditText
                            android:id="@+id/log_feedback_pref_other_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Please specify..."
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:padding="8dp"
                            android:background="@android:color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!--Log Feedback Input Fields-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ground Truth Log (Required)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Please write a correct and complete log based on your understanding of the past 1 hour (focus on actions, phone usage, scenarios). Recommended in English but Chinese is also accepted."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/log_feedback_ground_truth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLines="20"
                    android:hint="Please enter the standard answer (ground truth) in English..."
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:textSize="14sp"
                    android:gravity="top"
                    android:scrollbars="vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Optimization Suggestions - Optional (English)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/log_feedback_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLines="20"
                    android:hint="Please enter optimization suggestions in English (optional)..."
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:textSize="14sp"
                    android:gravity="top"
                    android:scrollbars="vertical"/>
            </LinearLayout>

            <!--Log Feedback Submit Button-->
            <Button
                android:id="@+id/submit_log_feedback_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/primary_color"
                android:text="Submit (Log Feedback)"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:padding="14dp"
                android:layout_marginBottom="32dp"/>
        </LinearLayout>

        <!-- Intervention Content Display Area (Suggestion)-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Current Suggestion"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/intervention_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_intervention"
                android:minHeight="180dp"
                android:padding="20dp"
                android:text="Loading..."
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/intervention_time_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Time range: -- to --"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

        </LinearLayout>

        <!--Atomic Activities Area (Hidden)-->
        <LinearLayout
            android:id="@+id/atomic_activities_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atomic Activity Sequence"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!--Atomic Activity Comments from Original File-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atomic activities represent the fundamental behavioral units that make up suggestions. Each activity type captures specific contextual information:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Sport type: Physical activity categories"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Currently showing: Sport Type only"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"/>

            <!--Operation Instructions-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Press to drag and reorder, tap to edit,Long Press to delete"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:spacing="12dp">

                <!--Sport Type-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sport Type"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_sport"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_sport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"/>

                <!--App Category-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="App Category"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_app_category"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_app_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--Location Information-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location Information"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_location"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--Movement Status-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Movement Status"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_movement"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_movement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--Step Information-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step Information"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_step"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--Phone Category-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phone Category"
                        android:textColor="@color/dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_add_phone_category"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_color"
                        android:textColor="@color/text_light"
                        android:padding="0dp"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_phone_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--Start Time-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Time"
                    android:textColor="@color/dark_gray"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_start_timestamp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>

                <!--End Time-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End Time"
                    android:textColor="@color/dark_gray"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_end_timestamp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_recycler_view"
                    android:padding="8dp"
                    android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_add_activity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_color"
                    android:text="Add Activity"
                    android:textColor="@color/text_light"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_remove_activity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remove Selected"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/primary_color"
                    android:textColor="@color/text_light"/>
            </LinearLayout>
            <Button
                android:id="@+id/btn_refresh_atomic_activities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Refresh Atomic Activities"
                android:backgroundTint="@color/primary_color"
                android:textColor="@color/text_light"/>

        </LinearLayout>

        <!--Feedback for Suggestion Form Area-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggestion Feedback"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(1 represents worst and 5 represents best)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:spacing="20dp">

                <!--Question 1-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Do you find the suggestion content relevant?"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/feedback_group_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/feedback_1_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Relevant"
                            android:textSize="14sp"/>

                        <RadioButton
                            android:id="@+id/feedback_1_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not relevant"
                            android:textSize="14sp"
                            android:layout_marginStart="16dp"/>
                    </RadioGroup>
                </LinearLayout>

                <!--Question 2-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. How would you rate the timeliness of the suggestion?"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/feedback_group_2"
