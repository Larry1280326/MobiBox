<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/border_edittext.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 设置边框 -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC" /> <!-- 边框颜色 -->

    <!-- 设置圆角（可选） -->
    <corners
        android:radius="10dp" /> <!-- 圆角半径 -->

    <!-- 设置文本框背景色 -->
    <solid
        android:color="#FFFFFF" /> <!-- 背景颜色 -->

</shape>