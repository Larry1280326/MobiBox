<!-- res/drawable/custom_button.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 设置背景颜色 -->
    <solid android:color="@color/Azure" /> <!-- 背景颜色 -->

    <!-- 设置圆角 -->
    <corners android:radius="15dp" /> <!-- 圆角半径 -->

    <!-- 设置边框（可选） -->
    <stroke
        android:width="1dp"
        android:color="#3700B3" /> <!-- 边框颜色 -->
</shape>